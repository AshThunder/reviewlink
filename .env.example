# Buffer app client (confidential). Never commit real values.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Must match a redirect URI registered on the app client, character-for-character.
BUFFER_REDIRECT_URI=https://localhost:3000/api/auth/callback
APP_URL=https://localhost:3000

# 32-byte secrets (e.g. openssl rand -hex 32)
SESSION_SECRET=
TOKEN_ENC_KEY=

# Upstash Redis (Vercel Marketplace). Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
